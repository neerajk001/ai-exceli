# AI Whiteboard environment variables.
# Copy to .env, fill in the values, and never commit .env.

# LLM (v0.4+). Used by packages/ai-core and, later, apps/api.
# The key lives on the server only; it must never reach the browser.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# API (v0.5+)
PORT=3001
# Only this origin may call the API (the Vite dev server).
WEB_ORIGIN=http://localhost:3000

# Web (v0.6+). Vite only exposes VITE_* vars to the browser.
VITE_API_URL=http://localhost:3001

# Docker Compose (optional). Defaults: web on port 3000 and API same-origin at /api.
# WEB_PORT=3000
# DOCKER_VITE_API_URL=/api
# API_IMAGE=tidytboard-api:local
# WEB_IMAGE=tidytboard-web:local

# Supabase auth + Postgres (v0.11+). Server-side only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Pooled connection string (transaction pooler, append ?pgbouncer=true) used at runtime.
DATABASE_URL=
# Direct connection string used by the Prisma CLI for migrations.
DIRECT_URL=

# Web auth (v0.11+). The anon key is public by design; data is protected by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# DEV ONLY: bearer token accepted by the API and auto-login token for the web app.
# Leave empty outside local development; never set these in production.
DEV_AUTH_TOKEN=
VITE_DEV_AUTH_TOKEN=
