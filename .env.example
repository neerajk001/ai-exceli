# AI Whiteboard environment variables.
# Copy to .env, fill in the values, and never commit .env.

# LLM (v0.4+). Used by packages/ai-core and, later, apps/api.
# The key lives on the server only; it must never reach the browser.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# API (v0.5+)
PORT=3001
# Only this origin may call the API (the Vite dev server).
WEB_ORIGIN=http://localhost:3000
